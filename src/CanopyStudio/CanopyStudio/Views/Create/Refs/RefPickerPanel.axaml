<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:refs="using:CanopyStudio.ViewModels.Create.Refs"
             xmlns:pick="using:CanopyStudio.Controls.Pickers"
             xmlns:views="using:CanopyStudio.Views.Create.Refs"
             x:Class="CanopyStudio.Views.Create.Refs.RefPickerPanel"
             x:DataType="refs:RefPickerModel"
             Width="420"
             Height="440">
  <UserControl.Styles>
    <Style Selector="ListBox#Rows ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource StudioRadius}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <TextBox x:Name="SearchBox"
             AutomationProperties.Name="Search"
             Text="{Binding Search}"
             Watermark="{Binding Watermark}" />
    <TextBlock Grid.Row="1"
               Margin="2,8,2,0"
               Classes="muted small"
               TextWrapping="Wrap"
               IsVisible="{Binding HasNote}"
               Text="{Binding Note}" />

    <Panel Grid.Row="2" Margin="0,8,0,0">
      <TextBlock IsVisible="{Binding NoChoices}"
                 Classes="muted"
                 Margin="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="{Binding EmptyText}" />
      <ListBox x:Name="Rows"
               AutomationProperties.Name="Choices"
               IsVisible="{Binding !NoChoices}"
               Background="Transparent"
               ItemsSource="{Binding Choices}"
               SelectedItem="{Binding Highlighted}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="refs:RefChoice">
            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="32">
              <pick:PickerIcon IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Margin="0,0,10,0"
                               IconId="{Binding Icon}"
                               Assets="{Binding $parent[views:RefPickerPanel].((refs:RefPickerModel)DataContext).Assets}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Classes.muted="{Binding !HasName}"
                         Text="{Binding Title}" />
              <TextBlock Grid.Column="2"
                         Margin="10,0,0,0"
                         Classes="mono muted"
                         VerticalAlignment="Center"
                         Text="{Binding Detail}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </Grid>
</UserControl>
