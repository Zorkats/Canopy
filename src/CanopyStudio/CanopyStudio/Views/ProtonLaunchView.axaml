<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CanopyStudio.ViewModels"
             x:Class="CanopyStudio.Views.ProtonLaunchView"
             x:DataType="vm:ProtonLaunchViewModel">
  <!-- The launch option Proton needs for Canopy to load, on Linux only. -->
  <Border Classes="pane" Padding="16,12" IsVisible="{Binding Needed}">
    <StackPanel Spacing="10">
      <TextBlock Classes="h3" Text="Steam launch option" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Explanation}" />
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock Classes="mono"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="0,0,16,0"
                             Text="{Binding LaunchOption}" />
        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyCommand}" />
      </Grid>
      <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" Text="{Binding Outcome}" />
    </StackPanel>
  </Border>
</UserControl>
